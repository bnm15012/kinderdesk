# ── MySQL database ────────────────────────────────────────────────────────────
# Use TiDB Cloud (free): https://tidbcloud.com
MYSQL_HOST=gateway01.eu-central-1.prod.aws.tidbcloud.com
MYSQL_PORT=4000
MYSQL_DATABASE=preschool_erp
MYSQL_USER=your-db-user
MYSQL_PASSWORD=your-db-password

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=local-dev-secret-change-in-production

# ── Cloudflare R2 — file storage (server-side only) ───────────────────────────
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=preschool-erp
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# ── SMTP — for notifications ──────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Preschool ERP <your@gmail.com>"

# ── Razorpay — payment processing (server-side only) ─────────────────────────
RAZORPAY_KEY_ID=rzp_live_xxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret

# ── App URL ───────────────────────────────────────────────────────────────────
VITE_APP_URL=https://your-production-domain.com
